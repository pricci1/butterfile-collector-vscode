{
  "name": "file-collections",
  "displayName": "Butterfile Collector",
  "description": "Create collection of files and perform actions over them",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "fileCollectionsView",
          "name": "File Collections"
        }
      ]
    },
    "commands": [
      {
        "command": "fileCollections.newCollection",
        "title": "New Collection",
        "category": "File Collections",
        "icon": "$(add)"
      },
      {
        "command": "fileCollections.refresh",
        "title": "Refresh Collections",
        "category": "File Collections",
        "icon": "$(refresh)"
      },
      {
        "command": "fileCollections.openAll",
        "title": "Open All Files",
        "category": "File Collections",
        "icon": "$(go-to-file)"
      },
      {
        "command": "fileCollections.addFiles",
        "title": "Add Files to Collection",
        "category": "File Collections",
        "icon": "$(add)"
      },
      {
        "command": "fileCollections.addActiveEditorFile",
        "title": "Add Active File to Collection",
        "category": "File Collections",
        "icon": "$(new-file)"
      },
      {
        "command": "fileCollections.addToCollection",
        "title": "Add to Collection",
        "category": "File Collections"
      },
      {
        "command": "fileCollections.copyPaths",
        "title": "Copy Paths",
        "category": "File Collections",
        "icon": "$(copy)"
      },
      {
        "command": "fileCollections.removeFile",
        "title": "Remove File",
        "category": "File Collections",
        "icon": "$(remove)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fileCollections.newCollection",
          "when": "view == fileCollectionsView",
          "group": "navigation"
        },
        {
          "command": "fileCollections.refresh",
          "when": "view == fileCollectionsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "fileCollections.openAll",
          "when": "view == fileCollectionsView && viewItem == collection",
          "group": "inline"
        },
        {
          "command": "fileCollections.addActiveEditorFile",
          "when": "view == fileCollectionsView && viewItem == collection",
          "group": "inline"
        },
        {
          "command": "fileCollections.copyPaths",
          "when": "view == fileCollectionsView && viewItem == collection",
          "group": "inline"
        },
        {
          "command": "fileCollections.addFiles",
          "when": "view == fileCollectionsView && viewItem == collection",
          "group": "1_modification"
        },
        {
          "command": "fileCollections.removeFile",
          "when": "view == fileCollectionsView && viewItem == collectionFile",
          "group": "inline"
        }
      ],
      "explorer/context": [
        {
          "command": "fileCollections.addToCollection",
          "group": "2_workspace"
        }
      ]
    },
    "configuration": {
      "title": "File Collections",
      "properties": {
        "fileCollections.pathSeparator": {
          "type": "string",
          "default": " ",
          "examples": [
            " ",
            ", ",
            "| ",
            ";"
          ],
          "description": "Character(s) used to separate paths when copying"
        },
        "fileCollections.copyRelativePath": {
          "type": "boolean",
          "default": true,
          "description": "When true, copied paths will be relative to the workspace root. Otherwise, absolute paths will be used."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.97.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.19.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  }
}
